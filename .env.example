# Postgres connection strings.
# On Vercel: add the "Postgres" storage integration (Neon-backed) and these
# are populated for you automatically. For local dev, run `vercel env pull .env`
# to copy them down, or point both at your own local/hosted Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Shared password gating the whole site (see src/proxy.ts). Anyone with this
# password can view and edit the inventory. Leave unset only for local dev
# if you don't want the login wall.
SITE_PASSWORD="change-me"

# Optional: require a Google Authenticator (TOTP) code in addition to the
# password. Leave unset to skip this second factor. Generate a secret with
# `npx tsx scripts/generate-totp-secret.ts` and scan the QR/enter the key
# it prints into Google Authenticator (or any TOTP app).
SITE_TOTP_SECRET=""
